server {
    listen 80 default_server;
    server_name _;
    return 421;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 421;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / { return 301 https://${DOMAIN}$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Cloud image orders can wait up to 600 seconds for Proxmox to import a disk.
    proxy_read_timeout 720s;

    location ~* ^/(?:admin/(?:test(?:/|$)|(?:node_monitor|metrics_debug|backup_debug)\.php(?:/|$))|test_[^/]*\.php(?:/|$)) { return 403; }
    location = /templates/vm_metrics.php { return 404; }
    location ^~ /.docker-private/ { return 403; }
    location ^~ /uploads/tickets/ { return 403; }
    location ^~ /backups/ { return 403; }
    location ^~ /cache/ { return 403; }
    location ^~ /temp/ { return 403; }
    location ^~ /logs/ { return 403; }
    location ^~ /bots/logs/ { return 403; }

    location = /console/socket {
        proxy_pass http://apache:8765;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_read_timeout 75s;
        access_log off;
    }

    location / {
        proxy_pass http://apache:80;
        proxy_set_header Host ${DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
